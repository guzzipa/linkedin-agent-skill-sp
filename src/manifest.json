{
  "manifest_version": 3,
  "name": "LinkedIn Commenter",
  "version": "0.1.0",
  "description": "Sugiere comentarios para posts de LinkedIn con Claude. Vos elegís, editás y publicás.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "LinkedIn Commenter: configuración"
  }
}
