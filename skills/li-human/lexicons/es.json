 "structures": [
  {
   "id": "no-es-solo",
   "regex": "(?i)\\bno (?:es|son|se trata(?: de)?) (?:solo|sólo|solamente|simplemente|únicamente)(?: de)? [^.!?\\n—]{2,70}\\s*[,.;:—–-]\\s*(?:es|son|se trata de)\\b",
   "name": "\"No es solo X, es Y\"",
   "fix": "Decí lo que querés decir. Borrá la mitad que prepara el contraste."
  },
  {
   "id": "no-es-x-es-y",
   "regex": "(?i)\\bno es [^.!?\\n,]{2,40}\\.\\s+es [^.!?\\n]{2,60}[.!]",
   "name": "\"No es X. Es Y.\"",
   "fix": "La inversión es la marca. Empezá por Y."
  },
  {
   "id": "no-se-trata",
   "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!;,]\\s*se trata de\\b",
   "name": "\"No se trata de X, se trata de Y\"",
   "fix": "Empezá por Y."
  },
  {
   "id": "no-solo-sino",
   "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
   "name": "\"No solo X, sino también Y\"",
   "fix": "Dos oraciones, o quedate con la mitad fuerte."
  },
