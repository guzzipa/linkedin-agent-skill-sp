 "structures": [
  {
   "id": "no-es-solo",
   "regex": "(?i)\\bno (?:es|son|se trata(?: de)?) (?:solo|sólo|solamente|simplemente|únicamente)(?: de)? [^.!?\\n—]{2,70}\\s*[,.;:—–-]\\s*(?:es|son|se trata de)\\b",
   "name": "\"No es solo X, es Y\"",
   "fix": "Decí lo que querés decir. Borrá la mitad que prepara el contraste."
  },
  {
   "id": "no-es-x-es-y",
   "regex": "(?i)\\bno es [^.!?\\n,]{2,40}\\.\\s+es [^.!?\\n]{2,60}[.!]",
   "name": "\"No es X. Es Y.\"",
   "fix": "La inversión es la marca. Empezá por Y."
  },
  {
   "id": "no-se-trata",
   "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!;,]\\s*se trata de\\b",
   "name": "\"No se trata de X, se trata de Y\"",
   "fix": "Empezá por Y."
  },
  {
   "id": "no-solo-sino",
   "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
   "name": "\"No solo X, sino también Y\"",
   "fix": "Dos oraciones, o quedate con la mitad fuerte."
  },
  {
   "id": "revelacion",
   "regex": "(?im)^\\s*¿(?:y )?(?:el|la|lo|los|las) (?:resultado|resultados|clave|mejor|peor|truco|secreto|problema|diferencia|respuesta|ironía|lección|moraleja)\\?\\s*$|^\\s*¿(?:por qué|sabés qué|sabes qué|cómo|y ahora)\\?\\s*$",
   "name": "Pregunta-revelación en una línea (\"¿El resultado?\")",
   "fix": "Respondé en la misma oración. No escenifiques el giro."
  },
  {
   "id": "spoiler",
   "regex": "(?i)\\b(?:spoiler(?: alert)?|alerta de spoiler|plot twist)\\s*:",
   "name": "\"Spoiler:\" / \"Plot twist:\"",
   "fix": "Si es un giro, se nota solo."
  },
  {
   "id": "anuncio",
   "regex": "(?i)\\b(?:esto es lo que (?:aprendí|aprendimos|descubrí|descubrimos)|te cuento (?:lo que|cómo|por qué)|(?:acá|aquí) (?:va|van) (?:lo que|mis|las|los)|d[eé]jame (?:explicarte|contarte)|hilo\\s*🧵|l[eé]e(?:lo)? (?:eso )?(?:de nuevo|otra vez)|leelo (?:de nuevo|otra vez))",
   "name": "Anuncio en vez de contenido (\"Esto es lo que aprendí\")",
   "fix": "Decí la lección. Salteá el anuncio."
  },
  {
   "id": "apertura-anuncio",
   "regex": "(?im)^\\s*hoy (?:quiero (?:hablar|compartir|contar)|vengo a|les traigo|te traigo)",
   "name": "Apertura \"Hoy quiero hablar de...\"",
   "fix": "La primera línea es el gancho. Empezá por el hecho."
  },
  {
   "id": "triada",
   "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
   "min": 1,
   "name": "Tríada de tres palabras",
   "fix": "Dos o cuatro. Tres es el ritmo por defecto del modelo."
  },
  {
   "id": "emoji-cohete",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F64C]",
   "name": "Emoji de manual (cohete, fuego, foco, brillos, diana, manos)",
   "fix": "Uno como máximo, y que no sea de estos."
  },
  {
   "id": "emoji-vinetas",
   "regex": "(?m)^\\s*(?:✅|👉|🔹|🔸|➡️|➡|✔️|✔|📌|💡|🚀|🔥|⭐)\\s?",
   "min": 3,
   "name": "Lista con emojis como viñetas",
   "fix": "Guiones simples. Las viñetas de emoji son el uniforme de la IA en LinkedIn."
  },
  {
   "id": "hashtag-muro",
   "regex": "(?:#\\w+[ \\t]*){4,}",
   "name": "Muro de hashtags (4+)",
   "fix": "LinkedIn ya no rankea por hashtags. Cero a dos, al final."
  },
  {
   "id": "cebo",
   "regex": "(?i)¿(?:qué|que) (?:opinás|opinan|opinas|piensan|pensás|piensas)\\?|¿(?:estás|están|estas) de acuerdo\\?|¿coincid(?:ís|en|es)\\?|¿a alguien más le (?:pasa|pasó)\\?|(?:contame|cuéntame|cuéntenme|cuéntanme) en (?:los )?comentarios|d[eé]j(?:a|á|en)(?:me)? (?:tu|su) opinión|etiquet(?:á|a|en) a (?:alguien|un amigo|una amiga|quien)|dale like si|compart(?:í|e|an) si",
   "name": "Cebo de interacción",
   "fix": "Hacé una pregunta que solo este post podría hacer, sobre lo específico de arriba."
  },
  {
   "id": "comenta-palabra",
   "regex": "(?i)\\bcoment(?:á|a|en|ad)\\s+[\\\"“'«]?[A-ZÁÉÍÓÚÑ0-9]{2,}[\\\"”'»]?\\s+y te (?:lo|la|los|las) (?:envío|mando|paso)",
   "name": "\"Comentá PALABRA y te lo mando\"",
   "fix": "Es el formato de cebo más reconocible. Dejá el recurso directo en el primer comentario."
  },
  {
   "id": "cierre-ensayo",
   "regex": "(?im)^\\s*(?:en resumen|en conclusión|en definitiva|para concluir|para cerrar|en síntesis)\\b",
   "name": "Cierre de ensayo (\"En resumen...\")",
   "fix": "Un post no necesita párrafo de conclusión."
  },
  {
   "id": "apertura-comentario",
   "regex": "(?im)^\\s*(?:excelente (?:post|aporte|reflexión|publicación)|gran (?:post|aporte|reflexión)|muy buen (?:punto|post|aporte)|totalmente de acuerdo|me encant[óo]|qué buena reflexión|gracias por compartir|coincido (?:100|totalmente))",
   "name": "Apertura de comentario invisible (\"Excelente post\", \"Totalmente de acuerdo\")",
   "fix": "Nadie lee esas palabras. Empezá por tu dato, tu caso o tu desacuerdo."
  },
  {
   "id": "como-ia",
   "regex": "(?i)\\bcomo (?:un )?modelo de lenguaje\\b|\\bcomo (?:una )?(?:ia|inteligencia artificial),? no (?:tengo|puedo)\\b",
   "name": "Autorreferencia del modelo",
   "fix": "Borrá la oración."
  },
  {
   "id": "title-case",
   "regex": "\\b[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+ (?:De|Del|La|Las|Los|El|En|Con|Para|Por|Tu|Tus|Su|Sus|Y|Que|Un|Una|Al) [A-ZÁÉÍÓÚÑ][a-záéíóúñ]+",
   "name": "Mayúsculas de título en inglés (\"Cómo Escalar Tu Equipo De Datos\")",
   "fix": "En español solo va mayúscula la primera palabra. Es un calco directo del inglés."
  },
  {
   "id": "gerundio-posterioridad",
   "regex": "(?i),\\s+(?:logrando|generando|permitiendo|consiguiendo|aumentando|reduciendo|mejorando|posicionando|convirtiendo|impulsando|garantizando|asegurando|alcanzando|obteniendo|aportando|resultando|dando lugar|lo que permitió|lo cual permitió)\\b",
   "name": "Gerundio de posterioridad (\"..., logrando un aumento\")",
   "fix": "Es la marca más típica del español de IA y de traducción. Cortá en dos: \"Cambiamos el proceso. Las ventas subieron 30%.\""
  },
  {
   "id": "pasiva-por",
   "min": 2,
   "regex": "(?i)\\b(?:fue|fueron|ha sido|han sido|había sido|habían sido|será|serán)\\s+(?:\\w+mente\\s+)?\\w+(?:ado|ada|ados|adas|ido|ida|idos|idas|cho|cha|chos|chas|to|ta|tos|tas)\\s+por\\b",
   "name": "Pasiva con \"por\" repetida (\"fue desarrollado por\")",
   "fix": "El español prefiere la activa: \"lo desarrolló el equipo\", \"lo armamos nosotros\"."
  },
  {
   "id": "adverbios-mente",
   "regex": "(?i)\\b\\w{4,}mente\\b[^.!?\\n]{0,50}\\b\\w{4,}mente\\b",
   "name": "Dos adverbios en -mente en la misma oración",
   "fix": "Sacá uno. Si son necesarios los dos, la RAE pide el primero sin -mente: \"clara y rápidamente\"."
  },
  {
   "id": "posesivo-calco",
   "regex": "(?i)\\b(?:levant|alc|abr|cerr|lav|cruz|apret|mov|tap)\\w*\\s+(?:mi|mis|tu|tus|su|sus|nuestr[oa]s?)\\s+(?:mano|manos|ojos|brazo|brazos|cabeza|puño|puños|dedos|piernas|boca|oídos)\\b",
   "name": "Posesivo calcado del inglés (\"levanté mi mano\")",
   "fix": "En español va el artículo: \"levanté la mano\", \"abrí los ojos\"."
  },
  {
   "id": "mayuscula-calco",
   "regex": "(?<=[a-záéíóúñ0-9,] )(?:Lunes|Martes|Miércoles|Jueves|Viernes|Sábado|Domingo|Enero|Febrero|Marzo|Junio|Julio|Agosto|Septiembre|Setiembre|Octubre|Noviembre|Diciembre|Español|Inglés|Portugués|Francés|Alemán|Italiano)\\b",
   "name": "Mayúscula del inglés en día, mes o idioma (\"en Enero\", \"en Español\")",
   "fix": "En español van en minúscula: \"en enero\", \"el lunes\", \"en español\"."
  },
  {
   "id": "andamiaje",
   "regex": "(?is)\\ben primer lugar\\b.{0,600}?\\ben segundo lugar\\b",
   "name": "Andamiaje de redacción escolar (\"en primer lugar... en segundo lugar\")",
   "fix": "En un post no hace falta numerar con palabras. Usá una lista o contalo en orden."
  }
 ],
