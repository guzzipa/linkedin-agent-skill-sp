{
  "manifest_version": 3,
  "name": "LinkedIn Commenter",
  "version": "0.6.0",
  "description": "Hace tu ronda de comentarios en LinkedIn con Claude, Gemini, DeepSeek u otra IA. Elige los posts, escribe los comentarios y vos publicás con un clic.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "LinkedIn Commenter: configuración"
  },
  "homepage_url": "https://github.com/guzzipa/linkedin-agent-skill-sp/tree/main/extension",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
